# Existing CampusReserve configuration
DATABASE_URL="postgresql://campusreserve_app:YOUR_PASSWORD@localhost:5432/campusreserve"
SHADOW_DATABASE_URL="postgresql://campusreserve_app:YOUR_PASSWORD@localhost:5432/campusreserve_shadow"
JWT_ACCESS_SECRET="64_HEX_CHARACTERS"

# Optional institutional email delivery
SMTP_HOST="smtp.your-college.edu"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="campusreserve@your-college.edu"
SMTP_PASSWORD="YOUR_SMTP_PASSWORD"
MAIL_FROM="campusreserve@your-college.edu"
SUPPORT_EMAIL="campusreserve@your-college.edu"
SMTP_HELO_NAME="campusreserve"
SMTP_REJECT_UNAUTHORIZED="true"

# Optional existing resource uploads
# RESOURCE_UPLOAD_DIR="..."
